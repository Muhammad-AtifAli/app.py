# =========================================================
# GENERAL FUNCTIONS
# =========================================================

def add_question(question):

    question["id"] = st.session_state.next_id

    st.session_state.next_id += 1

    st.session_state.questions.append(question)


def grouped_questions():

    groups = {
        question_type: []
        for question_type in QUESTION_TYPES
    }

    for question in st.session_state.questions:

        groups[question["type"]].append(question)

    return groups


def total_marks():

    return sum(
        float(question["marks"])
        for question in st.session_state.questions
    )


def format_marks(value):

    value = float(value)

    if value.is_integer():
        return str(int(value))

    return str(value)


def safe_filename(text):

    value = re.sub(
        r"[^A-Za-z0-9_-]+",
        "_",
        text.strip()
    )

    return value.strip("_") or "test"


def pdf_text(text):

    return escape(
        str(text)
    ).replace(
        "\n",
        "<br/>"
    )


def shuffled_matching(question):

    left_items = [
        item[0]
        for item in question["pairs"]
    ]

    right_items = [
        item[1]
        for item in question["pairs"]
    ]

    # Keep shuffling consistent for this particular question
    random.Random(
        question["id"]
    ).shuffle(
        right_items
    )

    return left_items, right_items


# =========================================================
# WORD DOCUMENT HEADER
# =========================================================

def word_header(
    document,
    info,
    answer_key=False
):

    # School name
    paragraph = document.add_paragraph()

    paragraph.alignment = (
        WD_ALIGN_PARAGRAPH.CENTER
    )

    run = paragraph.add_run(
        info["school"] or "School / Institution"
    )

    run.bold = True
    run.font.size = Pt(16)


    # Test title
    paragraph = document.add_paragraph()

    paragraph.alignment = (
        WD_ALIGN_PARAGRAPH.CENTER
    )

    run = paragraph.add_run(
        info["title"] or "Test Paper"
    )

    run.bold = True
    run.font.size = Pt(14)


    # Answer key heading
    if answer_key:

        paragraph = document.add_paragraph()

        paragraph.alignment = (
            WD_ALIGN_PARAGRAPH.CENTER
        )

        run = paragraph.add_run(
            "ANSWER KEY / TEACHER COPY"
        )

        run.bold = True


    # Test information table
    table = document.add_table(
        rows=3,
        cols=4
    )

    table.style = "Table Grid"

    table.alignment = (
        WD_TABLE_ALIGNMENT.CENTER
    )


    rows = [

        (
            "Subject",
            info["subject"],
            "Class",
            info["grade"]
        ),

        (
            "Date",
            info["date"],
            "Duration",
            info["duration"]
        ),

        (
            "Total Marks",
            format_marks(
                info["total_marks"]
            ),
            "Teacher",
            info["teacher"]
        ),
    ]


    for row_number, row_data in enumerate(rows):

        for column_number, value in enumerate(row_data):

            cell = table.cell(
                row_number,
                column_number
            )

            cell.text = str(value)

            if column_number in (0, 2):

                if cell.paragraphs[0].runs:

                    cell.paragraphs[0].runs[0].bold = True


    # Student information
    if not answer_key:

        paragraph = document.add_paragraph()

        paragraph.add_run(
            "Student Name: "
        ).bold = True

        paragraph.add_run(
            "____________________________   "
        )

        paragraph.add_run(
            "Roll No: "
        ).bold = True

        paragraph.add_run(
            "____________"
        )


    # Instructions
    if info["instructions"].strip():

        paragraph = document.add_paragraph()

        paragraph.add_run(
            "General Instructions: "
        ).bold = True

        paragraph.add_run(
            info["instructions"]
        )


# =========================================================
# ADD QUESTION TO WORD DOCUMENT
# =========================================================

def word_question(
    document,
    question,
    question_number,
    answer_key=False
):

    # Main question
    paragraph = document.add_paragraph()

    paragraph.paragraph_format.space_after = Pt(3)

    run = paragraph.add_run(

        f"Q{question_number}. "
        f"{question['text']} "
        f"[{format_marks(question['marks'])} marks]"

    )

    run.bold = True


    # -----------------------------------------------------
    # MCQ
    # -----------------------------------------------------

    if question["type"] == "Multiple Choice (MCQ)":

        for label, option in zip(
            "ABCD",
            question["options"]
        ):

            document.add_paragraph(
                f"{label}. {option}"
            )


        if answer_key:

            correct_index = "ABCD".index(
                question["correct"]
            )

            paragraph = document.add_paragraph()

            paragraph.add_run(

                f"Answer: "
                f"{question['correct']}. "
                f"{question['options'][correct_index]}"

            ).bold = True


    # -----------------------------------------------------
    # FILL IN THE BLANKS
    # -----------------------------------------------------

    elif question["type"] == "Fill in the Blanks":

        if answer_key:

            paragraph = document.add_paragraph()

            paragraph.add_run(
                f"Answer: {question['answer']}"
            ).bold = True

        else:

            document.add_paragraph(
                "Answer: ______________________________________________"
            )


    # -----------------------------------------------------
    # SHORT QUESTION
    # -----------------------------------------------------

    elif question["type"] == "Short Question":

        if answer_key:

            paragraph = document.add_paragraph()

            paragraph.add_run(
                "Suggested answer: "
            ).bold = True

            paragraph.add_run(
                question.get(
                    "answer",
                    ""
                )
            )

        else:

            number_of_lines = int(
                question.get(
                    "answer_lines",
                    3
                )
            )

            for _ in range(number_of_lines):

                document.add_paragraph(
                    "________________________________________________________________________________"
                )


    # -----------------------------------------------------
    # COLUMN MATCHING
    # -----------------------------------------------------

    elif question["type"] == "Column Matching":

        table = document.add_table(
            rows=1,
            cols=2
        )

        table.style = "Table Grid"

        table.alignment = (
            WD_TABLE_ALIGNMENT.CENTER
        )


        if answer_key:

            table.cell(
                0,
                0
            ).text = "Column A"

            table.cell(
                0,
                1
            ).text = "Correct Match"


            for left, right in question["pairs"]:

                row = table.add_row().cells

                row[0].text = left
                row[1].text = right


        else:

            table.cell(
                0,
                0
            ).text = "Column A"

            table.cell(
                0,
                1
            ).text = "Column B"


            left_items, right_items = shuffled_matching(
                question
            )


            for index in range(
                max(
                    len(left_items),
                    len(right_items)
                )
            ):

                row = table.add_row().cells


                if index < len(left_items):

                    row[0].text = (
                        f"{index + 1}. "
                        f"{left_items[index]}"
                    )


                if index < len(right_items):

                    row[1].text = (
                        f"{chr(65 + index)}. "
                        f"{right_items[index]}"
                    )


        # Bold table headings
        for cell in table.rows[0].cells:

            if cell.paragraphs[0].runs:

                cell.paragraphs[0].runs[0].bold = True


    # -----------------------------------------------------
    # LONG QUESTION
    # -----------------------------------------------------

    elif question["type"] == "Long Question":

        if answer_key:

            paragraph = document.add_paragraph()

            paragraph.add_run(
                "Suggested answer / marking points: "
            ).bold = True

            paragraph.add_run(
                question.get(
                    "answer",
                    ""
                )
            )

        else:

            number_of_lines = int(
                question.get(
                    "answer_lines",
                    10
                )
            )

            for _ in range(number_of_lines):

                document.add_paragraph(
                    "________________________________________________________________________________"
                )


    # Difficulty only shown in teacher copy
    if answer_key:

        paragraph = document.add_paragraph()

        run = paragraph.add_run(

            f"Difficulty: "
            f"{question.get('difficulty', 'Not set')}"

        )

        run.italic = True
        run.font.size = Pt(8)


# =========================================================
# CREATE WORD FILE
# =========================================================

def make_docx(
    info,
    answer_key=False
):

    document = Document()


    # Page margins
    for section in document.sections:

        section.top_margin = Inches(0.55)

        section.bottom_margin = Inches(0.55)

        section.left_margin = Inches(0.65)

        section.right_margin = Inches(0.65)


    # Normal font
    document.styles["Normal"].font.name = "Arial"

    document.styles["Normal"].font.size = Pt(10.5)


    word_header(
        document,
        info,
        answer_key
    )


    question_number = 1


    for question_type, questions in grouped_questions().items():

        if not questions:
            continue


        # Section title
        paragraph = document.add_paragraph()

        run = paragraph.add_run(
            SECTION_TITLES[
                question_type
            ]
        )

        run.bold = True
        run.font.size = Pt(12)


        # Section instruction
        paragraph = document.add_paragraph()

        run = paragraph.add_run(
            SECTION_INSTRUCTIONS[
                question_type
            ]
        )

        run.italic = True


        for question in questions:

            word_question(
                document,
                question,
                question_number,
                answer_key
            )

            question_number += 1


    output = io.BytesIO()

    document.save(output)

    return output.getvalue()


