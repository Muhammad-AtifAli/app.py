def page_number(
    canvas,
    document
):

    canvas.saveState()

    canvas.setFont(
        "Helvetica",
        8
    )

    canvas.drawCentredString(

        A4[0] / 2,

        8 * mm,

        f"Page {document.page}"

    )

    canvas.restoreState()


# =========================================================
# CREATE PDF
# =========================================================

def make_pdf(
    info,
    answer_key=False
):

    output = io.BytesIO()


    document = SimpleDocTemplate(

        output,

        pagesize=A4,

        leftMargin=14 * mm,

        rightMargin=14 * mm,

        topMargin=13 * mm,

        bottomMargin=14 * mm,

    )


    styles = getSampleStyleSheet()


    school_style = ParagraphStyle(

        "SchoolStyle",

        parent=styles["Heading1"],

        fontSize=16,

        alignment=TA_CENTER,

        spaceAfter=3

    )


    title_style = ParagraphStyle(

        "TitleStyle",

        parent=styles["Title"],

        fontSize=14,

        alignment=TA_CENTER,

        spaceAfter=5

    )


    section_style = ParagraphStyle(

        "SectionStyle",

        parent=styles["Heading2"],

        fontSize=11,

        spaceBefore=8,

        spaceAfter=2

    )


    normal_style = ParagraphStyle(

        "NormalStyle",

        parent=styles["BodyText"],

        fontSize=9.2,

        leading=11.5,

        spaceAfter=3

    )


    question_style = ParagraphStyle(

        "QuestionStyle",

        parent=normal_style,

        fontName="Helvetica-Bold",

        spaceBefore=5,

        spaceAfter=3

    )


    small_style = ParagraphStyle(

        "SmallStyle",

        parent=normal_style,

        fontSize=8.2,

        leading=10

    )


    story = []


    # School name
    story.append(

        Paragraph(

            pdf_text(
                info["school"]
                or "School / Institution"
            ),

            school_style

        )

    )


    # Test title
    story.append(

        Paragraph(

            pdf_text(
                info["title"]
                or "Test Paper"
            ),

            title_style

        )

    )


    # Answer key heading
    if answer_key:

        story.append(

            Paragraph(

                "<b>ANSWER KEY / TEACHER COPY</b>",

                normal_style

            )

        )


    # =====================================================
    # INFORMATION TABLE
    # =====================================================

    table_data = [

        [
            "Subject",
            info["subject"],
            "Class",
            info["grade"]
        ],

        [
            "Date",
            info["date"],
            "Duration",
            info["duration"]
        ],

        [
            "Total Marks",
            format_marks(
                info["total_marks"]
            ),
            "Teacher",
            info["teacher"]
        ],

    ]


    formatted_data = []


    for row in table_data:

        formatted_row = []

        for index, value in enumerate(row):

            if index in (0, 2):

                text = (
                    f"<b>{pdf_text(value)}</b>"
                )

            else:

                text = pdf_text(value)


            formatted_row.append(

                Paragraph(
                    text,
                    small_style
                )

            )


        formatted_data.append(
            formatted_row
        )


    info_table = Table(

        formatted_data,

        colWidths=[
            25 * mm,
            50 * mm,
            27 * mm,
            64 * mm
        ]

    )


    info_table.setStyle(

        TableStyle([

            (
                "GRID",
                (0, 0),
                (-1, -1),
                0.5,
                colors.grey
            ),

            (
                "VALIGN",
                (0, 0),
                (-1, -1),
                "MIDDLE"
            ),

            (
                "BACKGROUND",
                (0, 0),
                (0, -1),
                colors.whitesmoke
            ),

            (
                "BACKGROUND",
                (2, 0),
                (2, -1),
                colors.whitesmoke
            ),

            (
                "LEFTPADDING",
                (0, 0),
                (-1, -1),
                4
            ),

            (
                "RIGHTPADDING",
                (0, 0),
                (-1, -1),
                4
            ),

            (
                "TOPPADDING",
                (0, 0),
                (-1, -1),
                4
            ),

            (
                "BOTTOMPADDING",
                (0, 0),
                (-1, -1),
                4
            ),

        ])

    )


    story.append(
        info_table
    )

    story.append(
        Spacer(
            1,
            5
        )
    )


    # Student name
    if not answer_key:

        story.append(

            Paragraph(

                "<b>Student Name:</b> "
                "__________________________ "
                "&nbsp;&nbsp; "
                "<b>Roll No:</b> "
                "____________",

                normal_style

            )

        )


    # General instructions
    if info["instructions"].strip():

        story.append(

            Paragraph(

                f"<b>General Instructions:</b> "
                f"{pdf_text(info['instructions'])}",

                normal_style

            )

        )


    question_number = 1


    # =====================================================
    # QUESTIONS
    # =====================================================

    for question_type, questions in grouped_questions().items():

        if not questions:
            continue


        # Section title
        story.append(

            Paragraph(

                pdf_text(
                    SECTION_TITLES[
                        question_type
                    ]
                ),

                section_style

            )

        )


        # Section instruction
        story.append(

            Paragraph(

                f"<i>"
                f"{pdf_text(SECTION_INSTRUCTIONS[question_type])}"
                f"</i>",

                small_style

            )

        )


        for question in questions:

            block = []


            # Question heading
            block.append(

                Paragraph(

                    f"Q{question_number}. "
                    f"{pdf_text(question['text'])} "
                    f"<b>"
                    f"[{format_marks(question['marks'])} marks]"
                    f"</b>",

                    question_style

                )

            )


            # =================================================
            # MCQ
            # =================================================

            if question["type"] == "Multiple Choice (MCQ)":

                for label, option in zip(
                    "ABCD",
                    question["options"]
                ):

                    block.append(

                        Paragraph(

                            f"&nbsp;&nbsp;&nbsp;"
                            f"{label}. "
                            f"{pdf_text(option)}",

                            normal_style

                        )

                    )


                if answer_key:

                    correct_index = (
                        "ABCD".index(
                            question["correct"]
                        )
                    )

                    block.append(

                        Paragraph(

                            f"<b>Answer:</b> "
                            f"{question['correct']}. "
                            f"{pdf_text(question['options'][correct_index])}",

                            normal_style

                        )

                    )


            # =================================================
            # FILL IN THE BLANK
            # =================================================

            elif question["type"] == "Fill in the Blanks":

                if answer_key:

                    text = (

                        f"<b>Answer:</b> "
                        f"{pdf_text(question['answer'])}"

                    )

                else:

                    text = (
                        "Answer: "
                        "__________________________________________"
                    )


                block.append(

                    Paragraph(
                        text,
                        normal_style
                    )

                )


            # =================================================
            # SHORT QUESTION
            # =================================================

            elif question["type"] == "Short Question":

                if answer_key:

                    block.append(

                        Paragraph(

                            f"<b>Suggested answer:</b> "
                            f"{pdf_text(question.get('answer', ''))}",

                            normal_style

                        )

                    )

                else:

                    number_of_lines = int(

                        question.get(
                            "answer_lines",
                            3
                        )

                    )


                    for _ in range(number_of_lines):

                        block.append(

                            Paragraph(

                                "________________________________________________________________________________",

                                small_style

                            )

                        )


            # =================================================
            # MATCHING
            # =================================================

            elif question["type"] == "Column Matching":

                if answer_key:

                    rows = [

                        [
                            "Column A",
                            "Correct Match"
                        ]

                    ]


                    rows += question["pairs"]


                else:

                    left_items, right_items = (
                        shuffled_matching(
                            question
                        )
                    )


                    rows = [

                        [
                            "Column A",
                            "Column B"
                        ]

                    ]


                    for index in range(
                        len(left_items)
                    ):

                        rows.append([

                            f"{index + 1}. "
                            f"{left_items[index]}",

                            f"{chr(65 + index)}. "
                            f"{right_items[index]}"

                        ])


                formatted_rows = []


                for row_index, row in enumerate(rows):

                    formatted_row = []


                    for value in row:

                        if row_index == 0:

                            text = (
                                f"<b>"
                                f"{pdf_text(value)}"
                                f"</b>"
                            )

                        else:

                            text = pdf_text(
                                value
                            )


                        formatted_row.append(

                            Paragraph(
                                text,
                                small_style
                            )

                        )


                    formatted_rows.append(
                        formatted_row
                    )


                matching_table = Table(

                    formatted_rows,

                    colWidths=[
                        82 * mm,
                        82 * mm
                    ],

                    repeatRows=1

                )


                matching_table.setStyle(

                    TableStyle([

                        (
                            "GRID",
                            (0, 0),
                            (-1, -1),
                            0.45,
                            colors.grey
                        ),

                        (
                            "BACKGROUND",
                            (0, 0),
                            (-1, 0),
                            colors.whitesmoke
                        ),

                        (
                            "VALIGN",
                            (0, 0),
                            (-1, -1),
                            "TOP"
                        ),

                        (
                            "LEFTPADDING",
                            (0, 0),
                            (-1, -1),
                            5
                        ),

                        (
                            "RIGHTPADDING",
                            (0, 0),
                            (-1, -1),
                            5
                        ),

                        (
                            "TOPPADDING",
                            (0, 0),
                            (-1, -1),
                            4
                        ),

                        (
                            "BOTTOMPADDING",
                            (0, 0),
                            (-1, -1),
                            4
                        ),

                    ])

                )


                block.append(
                    matching_table
                )


            # =================================================
            # LONG QUESTION
            # =================================================

            elif question["type"] == "Long Question":

                if answer_key:

                    block.append(

                        Paragraph(

                            f"<b>"
                            f"Suggested answer / marking points:"
                            f"</b> "
                            f"{pdf_text(question.get('answer', ''))}",

                            normal_style

                        )

                    )

                else:

                    number_of_lines = int(

                        question.get(
                            "answer_lines",
                            10
                        )

                    )


                    for _ in range(number_of_lines):

                        block.append(

                            Paragraph(

                                "________________________________________________________________________________",

                                small_style

                            )

                        )


            # Difficulty in answer key
            if answer_key:

                block.append(

                    Paragraph(

                        f"<i>"
                        f"Difficulty: "
                        f"{pdf_text(question.get('difficulty', 'Not set'))}"
                        f"</i>",

                        small_style

                    )

                )


            story.append(
                KeepTogether(
                    block
                )
            )

            story.append(
                Spacer(
                    1,
                    4
                )
            )

            question_number += 1


    document.build(

        story,

        onFirstPage=page_number,

        onLaterPages=page_number

    )


    return output.getvalue()


