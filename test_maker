# TEST INFORMATION DICTIONARY
# =========================================================

info = {

    "school": school,

    "title": title,

    "subject": subject,

    "grade": grade,

    "teacher": teacher,

    "date": test_date.strftime(
        "%d %B %Y"
    ),

    "duration": duration,

    "instructions": instructions,

    "total_marks": total_marks(),

}


# =========================================================
# MAIN TABS
# =========================================================

add_tab, bank_tab, preview_tab = st.tabs(

    [

        "➕ Add Questions",

        "📚 Question Bank",

        "👁️ Preview & Export"

    ]

)


# =========================================================
# ADD QUESTIONS TAB
# =========================================================

with add_tab:

    st.subheader(
        "Add a Question"
    )


    question_type = st.selectbox(

        "Question type",

        QUESTION_TYPES

    )


    # Matching pair count must remain outside form
    if question_type == "Column Matching":

        pair_count = st.slider(

            "Number of matching pairs",

            min_value=2,

            max_value=10,

            value=4

        )

    else:

        pair_count = 0


    with st.form(
        "question_form",
        clear_on_submit=True
    ):

        question_text = st.text_area(

            "Question / instruction",

            placeholder="Enter your question here..."

        )


        options = []

        answer = ""

        correct = "A"

        pairs = []

        answer_lines = 3


        # =================================================
        # MCQ INPUTS
        # =================================================

        if question_type == "Multiple Choice (MCQ)":

            column1, column2 = st.columns(2)


            with column1:

                option_a = st.text_input(
                    "Option A"
                )

                option_c = st.text_input(
                    "Option C"
                )


            with column2:

                option_b = st.text_input(
                    "Option B"
                )

                option_d = st.text_input(
                    "Option D"
                )


            options = [

                option_a,

                option_b,

                option_c,

                option_d

            ]


            correct = st.selectbox(

                "Correct option",

                list("ABCD")

            )


        # =================================================
        # FILL BLANK INPUTS
        # =================================================

        elif question_type == "Fill in the Blanks":

            answer = st.text_input(
                "Correct answer"
            )


        # =================================================
        # SHORT QUESTION INPUTS
        # =================================================

        elif question_type == "Short Question":

            answer = st.text_area(

                "Suggested answer / key points"

            )


            answer_lines = st.number_input(

                "Answer lines",

                min_value=2,

                max_value=12,

                value=3

            )


        # =================================================
        # MATCHING INPUTS
        # =================================================

        elif question_type == "Column Matching":

            st.caption(

                "Enter the correct pairs. "
                "Column B will automatically be shuffled "
                "in the student test."

            )


            for index in range(
                pair_count
            ):

                column1, column2 = st.columns(2)


                with column1:

                    left = st.text_input(

                        f"Column A item {index + 1}",

                        key=(
                            f"left_"
                            f"{pair_count}_"
                            f"{index}"
                        )

                    )


                with column2:

                    right = st.text_input(

                        f"Correct match {index + 1}",

                        key=(
                            f"right_"
                            f"{pair_count}_"
                            f"{index}"
                        )

                    )


                pairs.append(
                    (
                        left,
                        right
                    )
                )


        # =================================================
        # LONG QUESTION INPUTS
        # =================================================

        elif question_type == "Long Question":

            answer = st.text_area(

                "Suggested answer / marking points",

                height=140

            )


            answer_lines = st.number_input(

                "Answer lines",

                min_value=5,

                max_value=30,

                value=10

            )


        # =================================================
        # COMMON SETTINGS
        # =================================================

        column1, column2 = st.columns(2)


        with column1:

            if question_type in (

                "Multiple Choice (MCQ)",

                "Fill in the Blanks"

            ):

                default_marks = 1.0

            else:

                default_marks = 5.0


            marks = st.number_input(

                "Marks",

                min_value=0.5,

                value=default_marks,

                step=0.5

            )


        with column2:

            difficulty = st.selectbox(

                "Difficulty",

                [

                    "Beginner",

                    "Intermediate",

                    "Advanced"

                ]

            )


        submitted = st.form_submit_button(

            "Add Question",

            type="primary",

            width="stretch"

        )


        # =================================================
        # VALIDATION
        # =================================================

        if submitted:

            error = None


            if not question_text.strip():

                error = (
                    "Enter the question or instruction."
                )


            elif (
                question_type
                == "Multiple Choice (MCQ)"
                and
                not all(
                    option.strip()
                    for option in options
                )
            ):

                error = (
                    "Enter all four MCQ options."
                )


            elif (
                question_type
                == "Fill in the Blanks"
                and
                not answer.strip()
            ):

                error = (
                    "Enter the correct answer."
                )


            elif question_type == "Column Matching":

                pairs = [

                    (
                        left.strip(),
                        right.strip()
                    )

                    for left, right in pairs

                    if (
                        left.strip()
                        and
                        right.strip()
                    )

                ]


                if len(pairs) < 2:

                    error = (

                        "Enter at least two "
                        "complete matching pairs."

                    )


            # =================================================
            # ADD QUESTION
            # =================================================

            if error:

                st.error(
                    error
                )


            else:

                question = {

                    "type":
                        question_type,

                    "text":
                        question_text.strip(),

                    "marks":
                        marks,

                    "difficulty":
                        difficulty

                }


                if question_type == "Multiple Choice (MCQ)":

                    question.update({

                        "options": [
                            option.strip()
                            for option in options
                        ],

                        "correct":
                            correct

                    })


                elif question_type in (

                    "Fill in the Blanks",

                    "Short Question",

                    "Long Question"

                ):

                    question.update({

                        "answer":
                            answer.strip()

                    })


                if question_type in (

                    "Short Question",

                    "Long Question"

                ):

                    question.update({

                        "answer_lines":
                            int(answer_lines)

                    })


                if question_type == "Column Matching":

                    question.update({

                        "pairs":
                            pairs

                    })


                add_question(
                    question
                )


                st.success(
                    "Question added successfully."
                )


                st.rerun()


# =========================================================
# QUESTION BANK TAB
# =========================================================

with bank_tab:

    st.subheader(
        "Question Bank"
    )


    if not st.session_state.questions:

        st.info(
            "No questions have been added yet."
        )


    else:

        question_number = 1


        for (
            question_type,
            questions
        ) in grouped_questions().items():


            if not questions:
                continue


            st.markdown(

                f"### "
                f"{SECTION_TITLES[question_type]}"

            )


            for question in questions:

                short_text = (
                    question["text"][:90]
                )


                with st.expander(

                    f"Q{question_number}. "
                    f"{short_text} "
                    f"| "
                    f"{format_marks(question['marks'])} marks"

                ):


                    st.write(
                        question["text"]
                    )


                    st.caption(

                        f"Difficulty: "
                        f"{question['difficulty']} "
                        f"| "
                        f"Marks: "
                        f"{format_marks(question['marks'])}"

                    )


                    # -----------------------------------------
                    # MCQ ANSWERS
                    # -----------------------------------------

                    if (
                        question_type
                        == "Multiple Choice (MCQ)"
                    ):

                        for label, option in zip(

                            "ABCD",

                            question["options"]

                        ):

                            if label == question["correct"]:

                                icon = "✅"

                            else:

                                icon = "•"


                            st.write(

                                f"{icon} "
                                f"{label}. "
                                f"{option}"

                            )


                    # -----------------------------------------
                    # NORMAL ANSWERS
                    # -----------------------------------------

                    elif question_type in (

                        "Fill in the Blanks",

                        "Short Question",

                        "Long Question"

                    ):

                        st.write(

                            "**Answer / key points:**",

                            question.get(
                                "answer",
                                ""
                            )

                        )


                    # -----------------------------------------
                    # MATCHING ANSWERS
                    # -----------------------------------------

                    elif question_type == "Column Matching":

                        st.table({

                            "Column A": [

                                item[0]

                                for item in question["pairs"]

                            ],

                            "Correct Match": [

                                item[1]

                                for item in question["pairs"]

                            ]

                        })


                    # Delete button
                    if st.button(

                        "Delete Question",

                        key=(
                            f"delete_"
                            f"{question['id']}"
                        )

                    ):


                        st.session_state.questions = [

                            item

                            for item
                            in st.session_state.questions

                            if (
                                item["id"]
                                !=
                                question["id"]
                            )

                        ]


                        st.rerun()


                question_number += 1


# =========================================================
# PREVIEW AND EXPORT TAB
# =========================================================

with preview_tab:

    st.subheader(
        "Preview & Export"
    )


    if not st.session_state.questions:

        st.info(
            "Add at least one question first."
        )


    else:

        info["total_marks"] = total_marks()


        # =================================================
        # SUMMARY
