                for value
                in grouped_questions().values()

            )

        )


        # =================================================
        # TEST HEADER
        # =================================================

        st.markdown(

            f"## "
            f"{school or 'School / Institution'}"

        )


        st.markdown(

            f"### "
            f"{title or 'Test Paper'}"

        )


        st.write(

            f"**Subject:** "
            f"{subject or '—'} "
            f"| "
            f"**Class:** "
            f"{grade or '—'} "
            f"| "
            f"**Date:** "
            f"{info['date']}"

        )


        st.write(

            f"**Duration:** "
            f"{duration or '—'} "
            f"| "
            f"**Total Marks:** "
            f"{format_marks(total_marks())}"

        )


        if instructions.strip():

            st.write(

                f"**Instructions:** "
                f"{instructions}"

            )


        st.divider()


        # =================================================
        # TEST PREVIEW
        # =================================================

        question_number = 1


        for (
            question_type,
            questions
        ) in grouped_questions().items():


            if not questions:
                continue


            st.markdown(

                f"### "
                f"{SECTION_TITLES[question_type]}"

            )


            st.caption(

                SECTION_INSTRUCTIONS[
                    question_type
                ]

            )


            for question in questions:

                st.markdown(

                    f"**Q{question_number}. "
                    f"{question['text']}** "
                    f"`["
                    f"{format_marks(question['marks'])} marks"
                    f"]`"

                )


                # -----------------------------------------
                # MCQ
                # -----------------------------------------

                if (
                    question_type
                    == "Multiple Choice (MCQ)"
                ):

                    for label, option in zip(

                        "ABCD",

                        question["options"]

                    ):

                        st.write(

                            f"{label}. "
                            f"{option}"

                        )


                # -----------------------------------------
                # FILL IN BLANK
                # -----------------------------------------

                elif question_type == "Fill in the Blanks":

                    st.write(

                        "Answer: "
                        "______________________________"

                    )


                # -----------------------------------------
                # MATCHING
                # -----------------------------------------

                elif question_type == "Column Matching":

                    left_items, right_items = (
                        shuffled_matching(
                            question
                        )
                    )


                    st.table({

                        "Column A": [

                            f"{index + 1}. {item}"

                            for index, item
                            in enumerate(
                                left_items
                            )

                        ],

                        "Column B": [

                            f"{chr(65 + index)}. {item}"

                            for index, item
                            in enumerate(
                                right_items
                            )

                        ]

                    })


                # -----------------------------------------
                # SHORT QUESTION
                # -----------------------------------------

                elif question_type == "Short Question":

                    for _ in range(2):

                        st.write(
                            "_" * 90
                        )


                # -----------------------------------------
                # LONG QUESTION
                # -----------------------------------------

                elif question_type == "Long Question":

                    for _ in range(4):

                        st.write(
                            "_" * 90
                        )


                question_number += 1


        st.divider()


